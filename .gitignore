# Системное
Thumbs.db
.DS_Store
desktop.ini

# Локальные настройки превью Claude Code
.claude/launch.json

# Python
__pycache__/
*.pyc

# генерация арта: замок манифеста на время записи
art/generated/.manifest.lock
art/generated/manifest.*.tmp

# Выгрузки других инструментов: черновики текстов, диалогов, музыки.
# В облако не идут. Что автор отберёт — переносится в docs/, art/ или source-data/
outputs/
